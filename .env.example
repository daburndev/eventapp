# Copy to .env.local for `npm run dev`. NEXT_PUBLIC_* values are baked in at build time.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. In production set it with: npx wrangler secret put SUPABASE_SECRET_KEY
SUPABASE_SECRET_KEY=sb_secret_xxx
# Optional: Cloudflare Turnstile site key for the guest form (leave empty in dev to skip).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
